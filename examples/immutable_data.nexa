function sum(values: Int[]): Int {
  let index = 0;
  let total = 0;

  while (index < values.length) {
    total = total + values[index];
    index = index + 1;
  }

  return total;
}

function main(args: String[]): Unit {
  const values: Int[] = [20, 22];
  print("Hello, " + args[0]);
  print(args[0] === "Nexa");
  print(values.length);
  print(sum(values));
}
