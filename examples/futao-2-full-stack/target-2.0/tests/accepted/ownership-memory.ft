import { Incident } from "../../src/model.ft";

function consume(take incident: Incident): Unit {}

class ZstDrop {
  function drop(mut self): Unit {
    DropTrace.record("zst-drop");
  }
}

function collections(): U64 {
  const utf8 = "Futao".clone();
  let markers = Vec<ZstDrop>();
  markers.push(ZstDrop());
  markers.push(ZstDrop());
  markers.reserve(32);
  const removed = markers.pop();
  drop(removed);
  const frozen = markers.freeze();
  return utf8.byteLength + frozen.length;
}

function ownershipAndMemory(take incident: Incident): U64 {
  const copy = incident.clone();
  let queue = Vec<Incident>();
  queue.push(incident);
  const frozen = queue.freeze();
  const boxed = Box.new(copy);
  const shared = Shared.new(boxed);
  const secondOwner = shared.clone();
  const observer = secondOwner.weak();
  let arena = DropArena.new();
  let labels = arena.vec<String>();
  labels.push("owned by arena");

  return match (observer.upgrade()) {
    case Some(owner) => frozen.length + 1;
    case None => frozen.length;
  };
}
