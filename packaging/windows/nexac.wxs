<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="nexac"
      Language="1033"
      Version="$(var.Version)"
      Manufacturer="baicie"
      UpgradeCode="{8C7C1A7A-8D59-4D76-9B6A-1C2EA2B7E4D6}">
    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of nexac is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Futao" />
      </Directory>
    </Directory>

    <Feature Id="ProductFeature" Title="nexac" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Product>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="NexacExecutable" Guid="{B1D4A3C7-3F9F-4C1A-9F5A-6E6E8C1F2A01}" Win64="yes">
        <File Id="NexacExe" Source="$(var.SourceDir)\nexac.exe" KeyPath="yes" />
        <Environment
            Id="NexacPath"
            Name="Path"
            Value="[INSTALLFOLDER]"
            Permanent="no"
            Part="last"
            Action="set"
            System="yes" />
      </Component>
      <Component Id="NexacReadme" Guid="{B1D4A3C7-3F9F-4C1A-9F5A-6E6E8C1F2A02}" Win64="yes">
        <File Id="ReadmeMd" Source="$(var.SourceDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="NexacLicense" Guid="{B1D4A3C7-3F9F-4C1A-9F5A-6E6E8C1F2A03}" Win64="yes">
        <File Id="LicenseFile" Source="$(var.SourceDir)\LICENSE" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="ProductComponents">
      <ComponentRef Id="NexacExecutable" />
      <ComponentRef Id="NexacReadme" />
      <ComponentRef Id="NexacLicense" />
    </ComponentGroup>
  </Fragment>
</Wix>
