export type Box<T> = {
  value: T;
};

export type Option<T> =
  | Some(value: T)
  | None();

export type Result<T, E> =
  | Ok(value: T)
  | Err(error: E);

export type Maybe<T> =
  | Some(value: T)
  | None();

export type List<T> =
  | Empty()
  | Node(head: T, tail: List<T>);

export function identity<T>(value: T): T {
  return value;
}

export function box<T>(value: T): Box<T> {
  return { value: value };
}

export function length<T>(values: List<T>): Int {
  return match (values) {
    case List.Empty() => 0;
    case List.Node(head, tail) => 1 + length(tail);
  };
}
