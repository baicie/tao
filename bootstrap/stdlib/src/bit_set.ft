export type BitSet = {
  values: Int[];
};

function containsBit(values: Int[], value: Int): Bool {
  for (const candidate of values) {
    if (candidate === value) {
      return true;
    }
  }
  return false;
}

export function bitSet(): BitSet {
  return { values: [] };
}

export function bitSetInsert(set: BitSet, value: Int): BitSet {
  if (value < 0 || containsBit(set.values, value)) {
    return set;
  }
  return { values: set.values.append(value) };
}

export function bitSetContains(set: BitSet, value: Int): Bool {
  if (value < 0) {
    return false;
  }
  return containsBit(set.values, value);
}

export function bitSetValues(set: BitSet): Int[] {
  return set.values;
}
