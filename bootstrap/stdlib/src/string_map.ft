import { Option } from "./option.ft";

export type StringMap<V> =
  | Empty()
  | Entries(keys: String[], values: V[]);

function findStringKey(keys: String[], key: String, start: Int, end: Int): Int {
  if (start >= end) {
    return -1;
  }
  if (end - start === 1) {
    if (keys[start] === key) {
      return start;
    }
    return -1;
  }
  const middle = start + (end - start) / 2;
  const left = findStringKey(keys, key, start, middle);
  if (left >= 0) {
    return left;
  }
  return findStringKey(keys, key, middle, end);
}

function replaceValue<V>(
  values: V[],
  target: Int,
  start: Int,
  end: Int,
  value: V
): V[] {
  if (start >= end) {
    return [];
  }
  if (end - start === 1) {
    if (start === target) {
      return [value];
    }
    return [values[start]];
  }
  const middle = start + (end - start) / 2;
  return replaceValue(values, target, start, middle, value).concat(
    replaceValue(values, target, middle, end, value)
  );
}

function insertEntry<V>(
  keys: String[],
  values: V[],
  key: String,
  value: V
): StringMap<V> {
  const index = findStringKey(keys, key, 0, keys.length);
  if (index < 0) {
    return StringMap.Entries(keys.append(key), values.append(value));
  }
  return StringMap.Entries(keys, replaceValue(values, index, 0, values.length, value));
}

function getEntry<V>(keys: String[], values: V[], key: String): Option<V> {
  const index = findStringKey(keys, key, 0, keys.length);
  if (index < 0) {
    return Option.None();
  }
  return Option.Some(values[index]);
}

export function stringMapInsert<V>(
  map: StringMap<V>,
  key: String,
  value: V
): StringMap<V> {
  return match (map) {
    case StringMap.Empty() => StringMap.Entries([key], [value]);
    case StringMap.Entries(keys, values) => insertEntry(keys, values, key, value);
  };
}

export function stringMapGet<V>(map: StringMap<V>, key: String): Option<V> {
  return match (map) {
    case StringMap.Empty() => Option.None();
    case StringMap.Entries(keys, values) => getEntry(keys, values, key);
  };
}

export function stringMapContains<V>(map: StringMap<V>, key: String): Bool {
  return match (map) {
    case StringMap.Empty() => false;
    case StringMap.Entries(keys, values) => findStringKey(keys, key, 0, keys.length) >= 0;
  };
}

export function stringMapKeys<V>(map: StringMap<V>): String[] {
  return match (map) {
    case StringMap.Empty() => [];
    case StringMap.Entries(keys, values) => keys;
  };
}
