export type StringSet = {
  values: String[];
};

export type IntSet = {
  values: Int[];
};

function containsString(values: String[], value: String, index: Int): Bool {
  if (index >= values.length) {
    return false;
  }
  if (values[index] === value) {
    return true;
  }
  return containsString(values, value, index + 1);
}

function containsInt(values: Int[], value: Int, index: Int): Bool {
  if (index >= values.length) {
    return false;
  }
  if (values[index] === value) {
    return true;
  }
  return containsInt(values, value, index + 1);
}

export function stringSet(): StringSet {
  return { values: [] };
}

export function stringSetInsert(set: StringSet, value: String): StringSet {
  if (containsString(set.values, value, 0)) {
    return set;
  }
  return { values: set.values.append(value) };
}

export function stringSetContains(set: StringSet, value: String): Bool {
  return containsString(set.values, value, 0);
}

export function stringSetValues(set: StringSet): String[] {
  return set.values;
}

export function intSet(): IntSet {
  return { values: [] };
}

export function intSetInsert(set: IntSet, value: Int): IntSet {
  if (containsInt(set.values, value, 0)) {
    return set;
  }
  return { values: set.values.append(value) };
}

export function intSetContains(set: IntSet, value: Int): Bool {
  return containsInt(set.values, value, 0);
}

export function intSetValues(set: IntSet): Int[] {
  return set.values;
}
