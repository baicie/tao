import { lex, LexerInput, LexerToken } from "./lexer.ft";

export type ParserCstEvent =
  | StartNode(kind: Int, offset: Int)
  | Token(kind: Int, start: Int, end: Int)
  | FinishNode(offset: Int);

export type ParserRecoveryEvent = {
  start: Int;
  end: Int;
};

export type ParserDiagnostic = {
  code: String;
  severity: String;
  labelStyle: String;
  start: Int;
  end: Int;
};

export type ParserResult = {
  cstEvents: ParserCstEvent[];
  recoveryEvents: ParserRecoveryEvent[];
  diagnostics: ParserDiagnostic[];
};

type OpenNode = {
  kind: Int;
  start: Int;
};

type Checkpoint = {
  eventIndex: Int;
  offset: Int;
};

type DeferredStartGroup = {
  eventIndex: Int;
  events: ParserCstEvent[];
};

type ParserState = {
  input: LexerInput;
  tokens: LexerToken[];
  position: Int;
  pendingSplitEq: Bool;
  events: ParserCstEvent[];
  deferredStarts: DeferredStartGroup[];
  openNodes: OpenNode[];
  recoveryEvents: ParserRecoveryEvent[];
  diagnostics: ParserDiagnostic[];
};

type ParseAttempt = {
  state: ParserState;
  parsed: Bool;
};

type StateFlag = {
  state: ParserState;
  value: Bool;
};

type ParameterChunk = {
  state: ParserState;
  finished: Bool;
  canRecoverMissingName: Bool;
};

type LookaheadChunk = {
  index: Int;
  remaining: Int;
  kind: Int;
  finished: Bool;
};

type ArrowScanChunk = {
  index: Int;
  depth: Int;
  found: Bool;
  finished: Bool;
};

function topLevelRecovery(): Int[] {
  return [92, 93, 12, 74];
}

function statementRecovery(): Int[] {
  return [9, 7, 16, 12, 13, 14, 15, 17, 101, 18, 19, 20, 80, 92, 93, 74];
}

function arrayRecovery(): Int[] {
  return [8, 67, 5, 9, 7, 16, 12, 13, 14, 15, 17, 101, 18, 19, 20, 80, 81, 82, 92, 93, 74];
}

function recordBodyRecovery(): Int[] {
  return [0, 9, 7, 92, 93, 12, 74];
}

function recordExpressionRecovery(): Int[] {
  return [8, 7, 67, 5, 9, 12, 13, 14, 15, 17, 101, 18, 19, 20, 80, 81, 82, 92, 93, 74];
}

function unionDeclarationRecovery(): Int[] {
  return [0, 83, 9, 92, 93, 12, 74];
}

function variantPayloadRecovery(): Int[] {
  return [0, 8, 5, 83, 9, 92, 93, 12, 74];
}

function matchBodyRecovery(): Int[] {
  return [81, 82, 7, 9, 13, 14, 15, 17, 101, 18, 19, 20, 80, 92, 93, 12, 74];
}

function matchArmRecovery(): Int[] {
  return [9, 81, 82, 7, 13, 14, 15, 17, 101, 18, 19, 20, 80, 92, 93, 12, 74];
}

function patternBindingRecovery(): Int[] {
  return [0, 8, 5, 84, 81, 82, 7];
}

function importListRecovery(): Int[] {
  return [0, 8, 7, 94, 64, 9, 92, 93, 12, 74];
}

function typeParameterRecovery(): Int[] {
  return [0, 8, 37, 38, 4, 6, 7, 26, 10, 9, 92, 93, 12, 74];
}

function typeArgumentRecovery(): Int[] {
  return [0, 23, 24, 65, 25, 4, 8, 37, 38, 67, 5, 6, 7, 26, 10, 9, 83, 84, 92, 93, 12, 74];
}

function parameterListRecovery(): Int[] {
  return [8, 5, 26, 84, 6, 7, 10, 9, 92, 93, 12, 74];
}

function forHeaderRecovery(): Int[] {
  return [5, 6, 7, 9, 13, 14, 15, 17, 101, 18, 19, 20];
}

function containsKind(values: Int[], kind: Int, index: Int): Bool {
  return containsKindRange(values, kind, index, values.length);
}

function containsKindRange(
  values: Int[],
  kind: Int,
  start: Int,
  end: Int
): Bool {
  if (start >= end) {
    return false;
  }
  if (end - start === 1) {
    return values[start] === kind;
  }
  const middle = start + (end - start) / 2;
  return containsKindRange(values, kind, start, middle) ||
    containsKindRange(values, kind, middle, end);
}

function eventRange(
  values: ParserCstEvent[],
  start: Int,
  end: Int
): ParserCstEvent[] {
  if (start >= end) {
    return [];
  }
  if (end - start === 1) {
    return [values[start]];
  }
  const middle = start + (end - start) / 2;
  return eventRange(values, start, middle).concat(eventRange(values, middle, end));
}

function reverseEventRange(
  values: ParserCstEvent[],
  start: Int,
  end: Int
): ParserCstEvent[] {
  if (start >= end) {
    return [];
  }
  if (end - start === 1) {
    return [values[start]];
  }
  const middle = start + (end - start) / 2;
  return reverseEventRange(values, middle, end).concat(
    reverseEventRange(values, start, middle)
  );
}

function deferredStartGroupRange(
  values: DeferredStartGroup[],
  start: Int,
  end: Int
): DeferredStartGroup[] {
  if (start >= end) {
    return [];
  }
  if (end - start === 1) {
    return [values[start]];
  }
  const middle = start + (end - start) / 2;
  return deferredStartGroupRange(values, start, middle).concat(
    deferredStartGroupRange(values, middle, end)
  );
}

function findDeferredStartGroup(
  groups: DeferredStartGroup[],
  eventIndex: Int,
  start: Int,
  end: Int
): Int {
  if (start >= end) {
    return -1;
  }
  const middle = start + (end - start) / 2;
  const candidate = groups[middle].eventIndex;
  if (candidate === eventIndex) {
    return middle;
  }
  if (candidate < eventIndex) {
    return findDeferredStartGroup(groups, eventIndex, middle + 1, end);
  }
  return findDeferredStartGroup(groups, eventIndex, start, middle);
}

function deferredStartInsertionIndex(
  groups: DeferredStartGroup[],
  eventIndex: Int,
  start: Int,
  end: Int
): Int {
  if (start >= end) {
    return start;
  }
  const middle = start + (end - start) / 2;
  if (groups[middle].eventIndex < eventIndex) {
    return deferredStartInsertionIndex(groups, eventIndex, middle + 1, end);
  }
  return deferredStartInsertionIndex(groups, eventIndex, start, middle);
}

function addDeferredStart(
  groups: DeferredStartGroup[],
  eventIndex: Int,
  event: ParserCstEvent
): DeferredStartGroup[] {
  const existing = findDeferredStartGroup(groups, eventIndex, 0, groups.length);
  if (existing >= 0) {
    const updated: DeferredStartGroup = {
      eventIndex: eventIndex,
      events: groups[existing].events.append(event)
    };
    return deferredStartGroupRange(groups, 0, existing)
      .append(updated)
      .concat(deferredStartGroupRange(groups, existing + 1, groups.length));
  }
  const insertion = deferredStartInsertionIndex(
    groups,
    eventIndex,
    0,
    groups.length
  );
  const created: DeferredStartGroup = {
    eventIndex: eventIndex,
    events: [event]
  };
  return deferredStartGroupRange(groups, 0, insertion)
    .append(created)
    .concat(deferredStartGroupRange(groups, insertion, groups.length));
}

function materializeEventRange(
  events: ParserCstEvent[],
  groups: DeferredStartGroup[],
  start: Int,
  end: Int,
  groupStart: Int,
  groupEnd: Int
): ParserCstEvent[] {
  if (start >= end) {
    return [];
  }
  if (groupStart >= groupEnd) {
    return eventRange(events, start, end);
  }
  if (end - start === 1) {
    return reverseEventRange(
      groups[groupStart].events,
      0,
      groups[groupStart].events.length
    ).append(events[start]);
  }
  const middle = start + (end - start) / 2;
  const groupMiddle = deferredStartInsertionIndex(
    groups,
    middle,
    groupStart,
    groupEnd
  );
  return materializeEventRange(
    events,
    groups,
    start,
    middle,
    groupStart,
    groupMiddle
  ).concat(
    materializeEventRange(
      events,
      groups,
      middle,
      end,
      groupMiddle,
      groupEnd
    )
  );
}

function materializeEvents(state: ParserState): ParserCstEvent[] {
  if (state.deferredStarts.length === 0) {
    return state.events;
  }
  return materializeEventRange(
    state.events,
    state.deferredStarts,
    0,
    state.events.length,
    0,
    state.deferredStarts.length
  );
}

function openNodeRange(values: OpenNode[], start: Int, end: Int): OpenNode[] {
  if (start >= end) {
    return [];
  }
  if (end - start === 1) {
    return [values[start]];
  }
  const middle = start + (end - start) / 2;
  return openNodeRange(values, start, middle).concat(openNodeRange(values, middle, end));
}

function withPosition(
  state: ParserState,
  position: Int,
  pendingSplitEq: Bool,
  events: ParserCstEvent[]
): ParserState {
  return {
    input: state.input,
    tokens: state.tokens,
    position: position,
    pendingSplitEq: pendingSplitEq,
    events: events,
    deferredStarts: state.deferredStarts,
    openNodes: state.openNodes,
    recoveryEvents: state.recoveryEvents,
    diagnostics: state.diagnostics
  };
}

function currentKind(state: ParserState): Int {
  if (state.pendingSplitEq) {
    return 10;
  }
  if (state.position >= state.tokens.length) {
    return -1;
  }
  return state.tokens[state.position].kind;
}

function currentStart(state: ParserState): Int {
  if (state.position >= state.tokens.length) {
    return state.input.byteLength;
  }
  const token = state.tokens[state.position];
  if (state.pendingSplitEq) {
    return token.start + 1;
  }
  return token.start;
}

function currentEnd(state: ParserState): Int {
  if (state.position >= state.tokens.length) {
    return state.input.byteLength;
  }
  return state.tokens[state.position].end;
}

function checkpoint(state: ParserState): Checkpoint {
  return {
    eventIndex: state.events.length,
    offset: currentStart(state)
  };
}

function startNode(state: ParserState, kind: Int): ParserState {
  const offset = currentStart(state);
  return {
    input: state.input,
    tokens: state.tokens,
    position: state.position,
    pendingSplitEq: state.pendingSplitEq,
    events: state.events.append(ParserCstEvent.StartNode(kind, offset)),
    deferredStarts: state.deferredStarts,
    openNodes: state.openNodes.append({ kind: kind, start: offset }),
    recoveryEvents: state.recoveryEvents,
    diagnostics: state.diagnostics
  };
}

function startNodeAt(
  state: ParserState,
  point: Checkpoint,
  kind: Int
): ParserState {
  const event = ParserCstEvent.StartNode(kind, point.offset);
  if (
    state.deferredStarts.length === 0 &&
    state.events.length - point.eventIndex <= 16
  ) {
    const prefix = eventRange(state.events, 0, point.eventIndex);
    const suffix = eventRange(
      state.events,
      point.eventIndex,
      state.events.length
    );
    return {
      input: state.input,
      tokens: state.tokens,
      position: state.position,
      pendingSplitEq: state.pendingSplitEq,
      events: prefix.append(event).concat(suffix),
      deferredStarts: state.deferredStarts,
      openNodes: state.openNodes.append({ kind: kind, start: point.offset }),
      recoveryEvents: state.recoveryEvents,
      diagnostics: state.diagnostics
    };
  }
  return {
    input: state.input,
    tokens: state.tokens,
    position: state.position,
    pendingSplitEq: state.pendingSplitEq,
    events: state.events,
    deferredStarts: addDeferredStart(
      state.deferredStarts,
      point.eventIndex,
      event
    ),
    openNodes: state.openNodes.append({ kind: kind, start: point.offset }),
    recoveryEvents: state.recoveryEvents,
    diagnostics: state.diagnostics
  };
}

function finishNode(state: ParserState): ParserState {
  const offset = currentStart(state);
  const open = state.openNodes[state.openNodes.length - 1];
  const remaining = openNodeRange(state.openNodes, 0, state.openNodes.length - 1);
  if (open.kind === 63) {
    return {
      input: state.input,
      tokens: state.tokens,
      position: state.position,
      pendingSplitEq: state.pendingSplitEq,
      events: state.events.append(ParserCstEvent.FinishNode(offset)),
      deferredStarts: state.deferredStarts,
      openNodes: remaining,
      recoveryEvents: state.recoveryEvents.append({ start: open.start, end: offset }),
      diagnostics: state.diagnostics
    };
  }
  return {
    input: state.input,
    tokens: state.tokens,
    position: state.position,
    pendingSplitEq: state.pendingSplitEq,
    events: state.events.append(ParserCstEvent.FinishNode(offset)),
    deferredStarts: state.deferredStarts,
    openNodes: remaining,
    recoveryEvents: state.recoveryEvents,
    diagnostics: state.diagnostics
  };
}

function bump(state: ParserState): ParserState {
  const token = state.tokens[state.position];
  if (state.pendingSplitEq) {
    return withPosition(
      state,
      state.position + 1,
      false,
      state.events.append(ParserCstEvent.Token(10, token.start + 1, token.end))
    );
  }
  return withPosition(
    state,
    state.position + 1,
    false,
    state.events.append(ParserCstEvent.Token(token.kind, token.start, token.end))
  );
}

function skipTrivia(state: ParserState): ParserState {
  const chunk = skipTriviaSmall(state, 16);
  if (chunk.value) {
    return chunk.state;
  }
  return skipTrivia(chunk.state);
}

function skipTriviaSmall(state: ParserState, remaining: Int): StateFlag {
  const kind = currentKind(state);
  if (!(kind === 2 || kind === 3)) {
    return { state: state, value: true };
  }
  if (remaining === 0) {
    return { state: state, value: false };
  }
  return skipTriviaSmall(bump(state), remaining - 1);
}

function errorAtCurrent(state: ParserState): ParserState {
  const diagnostic: ParserDiagnostic = {
    code: "E1001",
    severity: "error",
    labelStyle: "primary",
    start: currentStart(state),
    end: currentEnd(state)
  };
  return {
    input: state.input,
    tokens: state.tokens,
    position: state.position,
    pendingSplitEq: state.pendingSplitEq,
    events: state.events,
    deferredStarts: state.deferredStarts,
    openNodes: state.openNodes,
    recoveryEvents: state.recoveryEvents,
    diagnostics: state.diagnostics.append(diagnostic)
  };
}

function expect(state: ParserState, kind: Int): StateFlag {
  const skipped = skipTrivia(state);
  if (currentKind(skipped) === kind) {
    return { state: bump(skipped), value: true };
  }
  return { state: errorAtCurrent(skipped), value: false };
}

function atTypeListClose(state: ParserState): Bool {
  const kind = currentKind(state);
  return kind === 37 || kind === 38;
}

function bumpTypeListClose(state: ParserState): ParserState {
  if (currentKind(state) === 38) {
    const token = state.tokens[state.position];
    return withPosition(
      state,
      state.position,
      true,
      state.events.append(ParserCstEvent.Token(37, token.start, token.start + 1))
    );
  }
  return bump(state);
}

function expectTypeListClose(state: ParserState): StateFlag {
  const skipped = skipTrivia(state);
  if (atTypeListClose(skipped)) {
    return { state: bumpTypeListClose(skipped), value: true };
  }
  return { state: errorAtCurrent(skipped), value: false };
}

function recoverConsume(state: ParserState, recovery: Int[]): ParserState {
  const chunk = recoverConsumeSmall(state, recovery, 16);
  if (chunk.value) {
    return chunk.state;
  }
  return recoverConsume(chunk.state, recovery);
}

function recoverConsumeSmall(
  state: ParserState,
  recovery: Int[],
  remaining: Int
): StateFlag {
  const kind = currentKind(state);
  if (kind === -1 || containsKind(recovery, kind, 0)) {
    return { state: state, value: true };
  }
  if (remaining === 0) {
    return { state: state, value: false };
  }
  return recoverConsumeSmall(bump(state), recovery, remaining - 1);
}

function recoverTo(state: ParserState, recovery: Int[]): ParserState {
  const kind = currentKind(state);
  if (kind === -1 || containsKind(recovery, kind, 0)) {
    return state;
  }
  const opened = startNode(state, 63);
  return finishNode(recoverConsume(opened, recovery));
}

function recoverStatement(state: ParserState): ParserState {
  const recovered = recoverTo(state, statementRecovery());
  if (currentKind(recovered) === 9) {
    return bump(recovered);
  }
  return recovered;
}

function recoverRecordBody(state: ParserState): ParserState {
  const recovered = recoverTo(state, recordBodyRecovery());
  if (currentKind(recovered) === 9) {
    return bump(recovered);
  }
  return recovered;
}

function nthNonTriviaFrom(
  tokens: LexerToken[],
  index: Int,
  remaining: Int
): Int {
  const chunk = nthNonTriviaSmall(tokens, index, remaining, 16);
  if (chunk.finished) {
    return chunk.kind;
  }
  return nthNonTriviaFrom(tokens, chunk.index, chunk.remaining);
}

function nthNonTriviaSmall(
  tokens: LexerToken[],
  index: Int,
  remaining: Int,
  budget: Int
): LookaheadChunk {
  if (index >= tokens.length) {
    return {
      index: index,
      remaining: remaining,
      kind: -1,
      finished: true
    };
  }
  if (budget === 0) {
    return {
      index: index,
      remaining: remaining,
      kind: -1,
      finished: false
    };
  }
  const kind = tokens[index].kind;
  if (kind === 2 || kind === 3) {
    return nthNonTriviaSmall(tokens, index + 1, remaining, budget - 1);
  }
  if (remaining === 0) {
    return {
      index: index,
      remaining: remaining,
      kind: kind,
      finished: true
    };
  }
  return nthNonTriviaSmall(
    tokens,
    index + 1,
    remaining - 1,
    budget - 1
  );
}

function nthNonTrivia(state: ParserState, offset: Int): Int {
  if (state.pendingSplitEq) {
    if (offset === 0) {
      return 10;
    }
    return nthNonTriviaFrom(state.tokens, state.position + 1, offset - 1);
  }
  return nthNonTriviaFrom(state.tokens, state.position, offset);
}

function findByteOffset(
  offsets: Int[],
  target: Int,
  start: Int,
  end: Int
): Int {
  if (start >= end) {
    return -1;
  }
  if (end - start === 1) {
    if (offsets[start] === target) {
      return start;
    }
    return -1;
  }
  const middle = start + (end - start) / 2;
  if (offsets[middle] <= target) {
    return findByteOffset(offsets, target, middle, end);
  }
  return findByteOffset(offsets, target, start, middle);
}

function atContextualOf(state: ParserState): Bool {
  if (state.pendingSplitEq || !(currentKind(state) === 0)) {
    return false;
  }
  const token = state.tokens[state.position];
  if (!(token.end - token.start === 2)) {
    return false;
  }
  const index = findByteOffset(
    state.input.byteOffsets,
    token.start,
    0,
    state.input.byteOffsets.length
  );
  if (index < 0 || index + 2 >= state.input.byteOffsets.length) {
    return false;
  }
  return state.input.codePoints[index] === 111 &&
    state.input.codePoints[index + 1] === 102 &&
    state.input.byteOffsets[index + 2] === token.end;
}

function expectContextualOf(state: ParserState): StateFlag {
  const skipped = skipTrivia(state);
  if (atContextualOf(skipped)) {
    return { state: bump(skipped), value: true };
  }
  return { state: errorAtCurrent(skipped), value: false };
}

function isTypeStart(kind: Int): Bool {
  return kind === 23 || kind === 24 || kind === 65 || kind === 25 ||
    kind === 4 || kind === 0;
}

function atAssignmentStatement(state: ParserState): Bool {
  return nthNonTrivia(state, 0) === 0 && nthNonTrivia(state, 1) === 10;
}

function scanArrow(state: ParserState, index: Int, depth: Int): Bool {
  const chunk = scanArrowSmall(state, index, depth, 16);
  if (chunk.finished) {
    return chunk.found;
  }
  return scanArrow(state, chunk.index, chunk.depth);
}

function scanArrowSmall(
  state: ParserState,
  index: Int,
  depth: Int,
  remaining: Int
): ArrowScanChunk {
  if (index >= state.tokens.length) {
    return { index: index, depth: depth, found: false, finished: true };
  }
  if (remaining === 0) {
    return { index: index, depth: depth, found: false, finished: false };
  }
  const kind = state.tokens[index].kind;
  if (kind === 2 || kind === 3) {
    return scanArrowSmall(state, index + 1, depth, remaining - 1);
  }
  if (kind === 4) {
    return scanArrowSmall(state, index + 1, depth + 1, remaining - 1);
  }
  if (kind === 5) {
    if (depth === 1) {
      const next = nthNonTriviaFrom(state.tokens, index + 1, 0);
      return {
        index: index,
        depth: depth,
        found: next === 26 || next === 84,
        finished: true
      };
    }
    return scanArrowSmall(state, index + 1, depth - 1, remaining - 1);
  }
  return scanArrowSmall(state, index + 1, depth, remaining - 1);
}

function atArrowExpression(state: ParserState): Bool {
  if (!(currentKind(state) === 4)) {
    return false;
  }
  return scanArrow(state, state.position, 0);
}

function importListIsFinished(state: ParserState): Bool {
  const kind = currentKind(state);
  return kind === -1 || kind === 7 || kind === 94 || kind === 64 ||
    kind === 9 || kind === 92 || kind === 93 || kind === 12 || kind === 74;
}

function typeParameterListIsFinished(state: ParserState): Bool {
  const kind = currentKind(state);
  return kind === -1 || kind === 37 || kind === 38 || kind === 4 ||
    kind === 6 || kind === 7 || kind === 26 || kind === 10 || kind === 9 ||
    kind === 92 || kind === 93 || kind === 12 || kind === 74;
}

function atReservedParameterName(state: ParserState): Bool {
  const kind = currentKind(state);
  return (kind === 92 || kind === 93 || kind === 12 || kind === 74) &&
    nthNonTrivia(state, 1) === 26;
}

function parameterListIsFinished(
  state: ParserState,
  canRecoverMissingName: Bool
): Bool {
  if (atReservedParameterName(state)) {
    return false;
  }
  if (canRecoverMissingName && currentKind(state) === 26) {
    return false;
  }
  const kind = currentKind(state);
  return kind === -1 || kind === 5 || kind === 26 || kind === 84 ||
    kind === 6 || kind === 7 || kind === 10 || kind === 9 || kind === 92 ||
    kind === 93 || kind === 12 || kind === 74;
}

function typeArgumentListIsFinished(state: ParserState): Bool {
  const kind = currentKind(state);
  return kind === -1 || kind === 37 || kind === 38 || kind === 67 ||
    kind === 5 || kind === 6 || kind === 7 || kind === 26 || kind === 10 ||
    kind === 9 || kind === 83 || kind === 84 || kind === 92 || kind === 93 ||
    kind === 12 || kind === 74;
}

function scanTypeDeclaration(
  state: ParserState,
  offset: Int,
  closeIncludesEquals: Bool
): Bool {
  const kind = nthNonTrivia(state, offset);
  if (kind === 37) {
    return typeDeclarationAfterParameters(state, offset + 1, false);
  }
  if (kind === 38) {
    return typeDeclarationAfterParameters(state, offset + 1, true);
  }
  if (
    kind === -1 || kind === 10 || kind === 9 || kind === 92 || kind === 93 ||
    kind === 12 || kind === 74
  ) {
    return typeDeclarationAfterParameters(state, offset, closeIncludesEquals);
  }
  return scanTypeDeclaration(state, offset + 1, closeIncludesEquals);
}

function typeDeclarationAfterParameters(
  state: ParserState,
  offset: Int,
  closeIncludesEquals: Bool
): Bool {
  const nextOffset = ifOffsetHasEquals(state, offset, closeIncludesEquals);
  const kind = nthNonTrivia(state, nextOffset);
  return kind === 0 || kind === 83;
}

function ifOffsetHasEquals(
  state: ParserState,
  offset: Int,
  closeIncludesEquals: Bool
): Int {
  if (!closeIncludesEquals && nthNonTrivia(state, offset) === 10) {
    return offset + 1;
  }
  return offset;
}

function typeDeclarationIsUnion(state: ParserState): Bool {
  const afterName = ifAfterTypeName(state, 1);
  if (nthNonTrivia(state, afterName) === 35) {
    return scanTypeDeclaration(state, afterName + 1, false);
  }
  return typeDeclarationAfterParameters(state, afterName, false);
}

function ifAfterTypeName(state: ParserState, offset: Int): Int {
  if (nthNonTrivia(state, offset) === 0) {
    return offset + 1;
  }
  return offset;
}

function binaryPrecedence(state: ParserState): Int {
  const kind = currentKind(state);
  if (kind === 33) {
    return 1;
  }
  if (kind === 32) {
    return 2;
  }
  if (kind === 34) {
    return 3;
  }
  if (kind === 35 || kind === 36 || kind === 37 || kind === 38) {
    return 4;
  }
  if (kind === 27 || kind === 28) {
    return 5;
  }
  if (kind === 29 || kind === 30) {
    return 6;
  }
  return 0;
}

function parseSourceItems(state: ParserState): ParserState {
