  if (kind === 92) {
    return parseSourceItemsSmall(parseImportDeclaration(skipped), remaining - 1);
  }
  if (kind === 93) {
    return parseSourceItemsSmall(parseExportedDeclaration(skipped), remaining - 1);
  }
  if (kind === 12) {
    return parseSourceItemsSmall(parseFunctionDeclaration(skipped), remaining - 1);
  }
  if (kind === 74) {
    return parseSourceItemsSmall(parseTypeDeclaration(skipped), remaining - 1);
  }
  return parseSourceItemsSmall(parseUnexpectedTopLevelItem(skipped), remaining - 1);
}

function parseTypeDeclaration(state: ParserState): ParserState {
  if (typeDeclarationIsUnion(state)) {
    return parseUnionDeclaration(state);
  }
  return parseRecordDeclaration(state);
}

function parseImportDeclaration(state: ParserState): ParserState {
  const opened = startNode(state, 95);
