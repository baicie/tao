function parseParametersSmall(
  state: ParserState,
  canRecoverMissingName: Bool,
  remaining: Int
): ParameterChunk {
  if (currentKind(state) === -1 || parameterListIsFinished(state, canRecoverMissingName)) {
    return {
      state: state,
      finished: true,
      canRecoverMissingName: canRecoverMissingName
    };
  }
  if (remaining === 0) {
    return {
      state: state,
      finished: false,
      canRecoverMissingName: canRecoverMissingName
    };
  }
  const position = state.position;
  const parameter = parseParameter(state);
  const progressed = recoverParameter(parameter, position);
  const skipped = skipTrivia(progressed);
  if (currentKind(skipped) === 8) {
    const comma = skipTrivia(bump(skipped));
    if (currentKind(comma) === 5) {
      return {
        state: errorAtCurrent(comma),
        finished: true,
        canRecoverMissingName: true
      };
    }
    return parseParametersSmall(comma, true, remaining - 1);
  }
  if (!parameterListIsFinished(skipped, false)) {
    const reported = errorAtCurrent(skipped);
    const recovered = recoverTo(reported, parameterListRecovery());
    if (currentKind(recovered) === 8) {
      return parseParametersSmall(
        skipTrivia(bump(recovered)),
        true,
        remaining - 1
