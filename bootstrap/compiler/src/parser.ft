function parseUnionVariantsSmall(
  state: ParserState,
  parsedVariant: Bool,
  remaining: Int
): StateFlag {
  const skipped = skipTrivia(state);
  const kind = currentKind(skipped);
  if (remaining === 0) {
    return { state: skipped, value: false };
  }
  if (kind === 0) {
    const variant = parseUnionVariant(skipped);
    const afterVariant = skipTrivia(variant);
    if (currentKind(afterVariant) === 83) {
      const pipe = skipTrivia(bump(afterVariant));
      const afterPipe = currentKind(pipe);
      if (
        afterPipe === -1 || afterPipe === 9 || afterPipe === 92 ||
        afterPipe === 93 || afterPipe === 12 || afterPipe === 74
      ) {
        return { state: errorAtCurrent(pipe), value: true };
      }
      return parseUnionVariantsSmall(pipe, true, remaining - 1);
    }
    if (currentKind(afterVariant) === 0) {
      return parseUnionVariantsSmall(
        errorAtCurrent(afterVariant),
        true,
        remaining - 1
      );
    }
    return { state: afterVariant, value: true };
  }
  if (
    kind === -1 || kind === 9 || kind === 92 || kind === 93 || kind === 12 ||
    kind === 74
  ) {
    if (parsedVariant) {
      return { state: skipped, value: true };
    }
    return { state: errorAtCurrent(skipped), value: true };
  }
  const reported = errorAtCurrent(skipped);
  const recovered = recoverTo(reported, unionDeclarationRecovery());
  if (currentKind(recovered) === 0) {
    return parseUnionVariantsSmall(recovered, parsedVariant, remaining - 1);
  }
  if (currentKind(recovered) === 83) {
