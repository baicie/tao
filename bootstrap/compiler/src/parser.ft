  }
  if (atTypeListClose(skipped) || typeArgumentListIsFinished(skipped)) {
    return { state: skipped, value: true };
  }
  if (isTypeStart(currentKind(skipped))) {
    return parseTypeArgumentsSmall(errorAtCurrent(skipped), remaining - 1);
