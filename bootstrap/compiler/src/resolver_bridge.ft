import { LexerInput } from "./lexer.ft";
import {
  ResolverInput,
  ResolverSourceInput,
  ResolverOutcome,
  resolve
} from "./resolver.ft";
import { Sequence, append, toArray } from "./sequence.ft";

type SourceDecodeState = {
  position: Int;
  sources: Sequence<ResolverSourceInput>;
  valid: Bool;
};

function parseRange(values: String[], start: Int, end: Int): Int[] {
  if (start >= end) {
    return [];
  }
  if (end - start === 1) {
    return [parseInt(values[start])];
  }
  const middle = start + (end - start) / 2;
  return parseRange(values, start, middle).concat(
    parseRange(values, middle, end)
  );
}

function valueRange(
  values: Int[],
  start: Int,
  end: Int
): Int[] {
  if (start >= end) {
    return [];
  }
  if (end - start === 1) {
    return [values[start]];
  }
  const middle = start + (end - start) / 2;
  return valueRange(values, start, middle).concat(
    valueRange(values, middle, end)
  );
}

function codePointPairRange(
  values: Int[],
  base: Int,
  start: Int,
  end: Int
): Int[] {
  if (start >= end) {
    return [];
  }
  if (end - start === 1) {
    return [values[base + start * 2]];
  }
  const middle = start + (end - start) / 2;
  return codePointPairRange(values, base, start, middle).concat(
    codePointPairRange(values, base, middle, end)
  );
}

function byteOffsetPairRange(
  values: Int[],
  base: Int,
  start: Int,
  end: Int
): Int[] {
  if (start >= end) {
    return [];
  }
  if (end - start === 1) {
    return [values[base + start * 2 + 1]];
  }
  const middle = start + (end - start) / 2;
  return byteOffsetPairRange(values, base, start, middle).concat(
    byteOffsetPairRange(values, base, middle, end)
  );
}

function stepSourceDecode(
  values: Int[],
  state: SourceDecodeState
): SourceDecodeState {
  if (!state.valid || state.position + 3 > values.length) {
    return { position: state.position, sources: state.sources, valid: false };
  }
  const identityCount = values[state.position];
  const identityStart = state.position + 1;
  const identityEnd = identityStart + identityCount;
  if (identityCount < 0 || identityEnd + 2 > values.length) {
    return { position: state.position, sources: state.sources, valid: false };
  }
  const byteLength = values[identityEnd];
  const pairCount = values[identityEnd + 1];
  const base = identityEnd + 2;
  if (
    byteLength < 0 || pairCount < 0 ||
    base + pairCount * 2 > values.length
  ) {
    return { position: state.position, sources: state.sources, valid: false };
  }
  const sourceCodePoints = codePointPairRange(values, base, 0, pairCount);
  const byteOffsets = byteOffsetPairRange(values, base, 0, pairCount)
    .append(byteLength);
  const source: LexerInput = {
    codePoints: sourceCodePoints,
    byteOffsets: byteOffsets,
    byteLength: byteLength
  };
  return {
    position: base + pairCount * 2,
    sources: append(state.sources, {
      identity: valueRange(values, identityStart, identityEnd),
      source: source
    }),
    valid: true
  };
}

function decodeSourceRange(
  values: Int[],
  remaining: Int,
  state: SourceDecodeState
): SourceDecodeState {
  if (!state.valid || remaining <= 0) {
    return state;
  }
  return decodeSourceRange(values, remaining - 1, stepSourceDecode(values, state));
}

export function resolveEncoded(arguments: String[]): ResolverOutcome {
  const values = parseRange(arguments, 0, arguments.length);
  if (values.length < 2 || values[0] < 0) {
    return ResolverOutcome.InvalidInput();
  }
  const entryCount = values[0];
  const entryStart = 1;
  const entryEnd = entryStart + entryCount;
  if (entryEnd >= values.length || entryCount < 0) {
    return ResolverOutcome.InvalidInput();
  }
  const sourceCount = values[entryEnd];
  if (sourceCount <= 0) {
    return ResolverOutcome.InvalidInput();
  }
  const sourceInitial: SourceDecodeState = {
    position: entryEnd + 1,
    sources: { chunks: [], tail: [], length: 0 },
    valid: true
  };
  const decodedSources = decodeSourceRange(
    values,
    sourceCount,
    sourceInitial
  );
  if (!decodedSources.valid || !(decodedSources.position === values.length)) {
    return ResolverOutcome.InvalidInput();
  }
  const input: ResolverInput = {
    entry: valueRange(values, entryStart, entryEnd),
    sources: toArray(decodedSources.sources)
  };
  return resolve(input);
}
